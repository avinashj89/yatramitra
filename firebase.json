{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "test", "*.log"]
    }
  ],
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8085 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
