<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 and newer ask the user before an app may show notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only asked for when someone taps "Use my current location" or sends an SOS. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YatraMitra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.YatraMitra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- yatramitra://join?code=XXXXXX lets the existing "Invite" share action hand
                 someone a tappable link instead of a code they have to type in by hand. Only
                 works if the app is already installed (no App Links/custom domain set up), so
                 every invite message still states the plain code too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yatramitra" android:host="join" />
            </intent-filter>
        </activity>

        <!-- Receives trip notifications (Group chat, trip started, expenses, people joining)
             pushed by the server function in functions/index.js. -->
        <service
            android:name=".push.YatraMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="trip_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>

</manifest>
