<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.YatraMitra" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Matches the Compose surface color so the window shows the right background the
             instant it's created, before Compose has a chance to render (avoids a white/default
             flash on cold start). -->
        <item name="android:windowBackground">@color/background</item>
        <!-- Tints system-drawn chrome that lives outside Compose (e.g. the recent-apps card). -->
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
