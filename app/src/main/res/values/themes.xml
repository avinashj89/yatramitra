<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.YatraMitra" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Matches the Compose surface color so the window shows the right background the
             instant it's created, before Compose has a chance to render (avoids a white/default
             flash on cold start). -->
        <item name="android:windowBackground">@color/background</item>
        <!-- Tints system-drawn chrome that lives outside Compose (e.g. the recent-apps card). -->
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <!-- This base theme is a fixed Light theme (not DayNight) because Compose's own
             YatraMitraTheme is the real source of truth for light/dark colors. Without this flag,
             on a device running system dark mode (API 29+) Android's "force dark" feature assumes
             an app with a Light-only theme hasn't opted into dark mode and forcibly inverts the
             luminance of views it draws, including the ComposeView, which fights with Compose's
             own correct theming and is what caused sign-in screen text to render white-on-white
             and invisible. This opts the whole app out of that OS-level inversion so only
             Compose's own (correct) theme colors are ever shown. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
