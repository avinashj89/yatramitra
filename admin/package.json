{
  "name": "yatramitra-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Admin panel for YatraMitra: watch trips, people, chat, expenses and devices live from Firestore.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "cd .. && npx --yes firebase-tools@13 emulators:exec --only firestore --project demo-yatramitra \"cd admin && npx vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^8.29.3",
    "@mui/x-data-grid": "^8.29.3",
    "dayjs": "^1.11.13",
    "firebase": "^12.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
