rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules.
// Everyone using the app now has a real account (email+password or phone/OTP), and trip data is
// still gated by *knowing the trip code* — the same way a shared link would work — not by being a
// specific account. "get" (fetch one specific trip you already have the code for) is allowed, but
// "list" (browse every trip that exists) is explicitly denied, so nobody can dump every trip in
// the database without ever knowing a code. Subcollection queries for members/expenses/etc. are
// always scoped to one already-known tripCode by the request path itself, so they stay listable
// without reopening that hole.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }

      match /itineraryDays/{dayId} {
        allow read, write: if request.auth != null;
      }

      match /routeSuggestions/{suggestionId} {
        allow read, write: if request.auth != null;
      }

      match /itinerarySuggestions/{suggestionId} {
        allow read, write: if request.auth != null;
      }
    }

    // Each signed-in user's own "recent trips" index for their homepage. Unlike trips/**, this
    // *is* gated by account identity, not a shared code — nobody but you can read or write your
    // own trip list.
    match /users/{userId}/trips/{tripId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
