rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules.
// It allows anyone signed in anonymously by the YatraMitra app (which happens automatically)
// to read/write trip data, while blocking access to anyone not using the app at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripCode} {
      allow read, write: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
