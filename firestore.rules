rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules.
// Everyone using the app now has a real account (email+password or phone/OTP), and trip data is
// still gated by *knowing the trip code* — the same way a shared link would work — not by being a
// specific account. "get" (fetch one specific trip you already have the code for) is allowed, but
// "list" (browse every trip that exists) is explicitly denied, so nobody can dump every trip in
// the database without ever knowing a code. Subcollection queries for members/expenses/etc. are
// always scoped to one already-known tripCode by the request path itself, so they stay listable
// without reopening that hole.
//
// Admins (the web admin panel in admin/) are accounts with a document at admins/{uid}. They can
// also list every trip and read across all trips; nobody else can. The first admin document is
// created by hand in Firebase Console; after that, admins can add or remove other admins.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // You may check whether you yourself are an admin (that's how the panel decides to open).
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    match /trips/{tripCode} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow write: if request.auth != null;

      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }

      match /itineraryDays/{dayId} {
        allow read, write: if request.auth != null;
      }

      match /routeSuggestions/{suggestionId} {
        allow read, write: if request.auth != null;
      }

      match /itinerarySuggestions/{suggestionId} {
        allow read, write: if request.auth != null;
      }

      // The trip's Group chat. Same code-based trust as the rest of the trip.
      match /chat/{messageId} {
        allow read, write: if request.auth != null;
      }

      // Hospitals along each route day (from OpenStreetMap), saved for the whole group.
      match /hospitals/{dayId} {
        allow read, write: if request.auth != null;
      }
    }

    // Reading members, expenses and chat across *all* trips at once (collection-group queries)
    // is for admins only; the app always reads them inside one trip, under the rules above.
    match /{path=**}/members/{memberId} {
      allow read: if isAdmin();
    }
    match /{path=**}/expenses/{expenseId} {
      allow read: if isAdmin();
    }
    match /{path=**}/chat/{messageId} {
      allow read: if isAdmin();
    }

    // Which account each phone's notifications belong to (document id = the phone's push token).
    // A phone can only point its own token at the account signed in on it, and only that account
    // can remove it. The app never reads these; the server function and admins do.
    match /deviceTokens/{token} {
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // Each signed-in user's own "recent trips" index for their homepage. Unlike trips/**, this
    // *is* gated by account identity, not a shared code: only you can read, change or remove
    // entries in your own trip list. One exception lets an Organizer who adds you to a trip by
    // your phone or email put that trip on your homepage: someone else may *create* (never
    // overwrite) an entry in your list, but only one that points at a real member of that trip
    // whose account id is yours.
    match /users/{userId}/trips/{tripId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.resource.data.memberId)).data.uid == userId
      );
    }

    // Each signed-in user's own small discoverable profile (name/email/phone), written once per
    // sign-in. "get" (fetch one you already know the id of) and "list" (query by email or phone)
    // are both allowed to any signed-in user -- this is what lets "Add a travel companion" detect
    // that a phone/email already belongs to a registered account and link the two, since there's
    // no push-notification system in this app for any other way for them to find out they were
    // added. This is a deliberate, minor tradeoff: any signed-in user can confirm a given email or
    // phone number is registered and see its name, the same shape of tradeoff contacts-based
    // matching apps generally accept. Writing your own profile is still owner-only.
    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
